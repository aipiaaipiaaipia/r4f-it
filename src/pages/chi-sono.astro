---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import Pill from "../components/ui/Pill.astro";
import Card from "../components/ui/Card.astro";
import Button from "../components/ui/Button.astro";
import RotatedBadge from "../components/kinetic/RotatedBadge.astro";
import MagneticCTA from "../components/kinetic/MagneticCTA.astro";
import {
  buildGraph,
  organizationSchema,
  personSchema,
  breadcrumbSchema,
} from "../lib/schema";
import { RAFAEL, contattiRP } from "../lib/site";

const title = "Rafael Patron — Chief AI Officer (CAIO) e Presidente CTS AIPIA | r4f.it";
const description =
  "Rafael Patron: Chief AI Officer (CAIO) di Intarget DMCC, Presidente del Comitato Tecnico-Scientifico AIPIA, 20 anni tra tecnologia e crescita, autore di quattro libri. Su r4f.it: LLMO e AI Search.";

const schema = buildGraph(
  organizationSchema(),
  personSchema(),
  breadcrumbSchema([
    { name: "Home", url: "https://r4f.it/" },
    { name: "Chi sono", url: "https://r4f.it/chi-sono" },
  ])
);

const credentials = [
  { title: "Chief AI Officer (CAIO) — Intarget DMCC", body: "Da giugno 2026. In precedenza AI Program Manager di Intarget DMCC, da ottobre 2019 a giugno 2026." },
  { title: "Presidente CTS AIPIA", body: "Dal 2025 presiedo il Comitato Tecnico-Scientifico dell'Associazione Italiana Professionisti dell'Intelligenza Artificiale." },
  { title: "Autore e ricerca", body: "Quattro libri tra AI, LLMO e growth hacking. Nel 2026 ho curato il Glossario dell'intelligenza artificiale e firmato due paper su AI Literacy (art. 4 AI Act) e terminologia AI." },
];

const teachings = [
  { where: "IED Milano", what: "Docente 2014–2020, dopo il corso di specializzazione Evolution Marketing and Social Media" },
  { where: "AIPIA", what: "Formazione e divulgazione su AI generativa, AI Literacy e AI Act" },
  { where: "r4f.it", what: "Workshop LLMO e AI Search per team marketing, content e SEO" },
];

const skills = [
  "Large Language Model Optimization", "AIO", "Generative Engine Optimization",
  "Answer Engine Optimization", "AI Strategy", "AI Governance", "EU AI Act",
  "Schema.org Structured Data", "Knowledge Graph", "Wikidata Entity Authority",
  "Technical SEO", "Prompt Engineering", "RAG Architecture",
  "Growth Hacking", "Automation",
];
---

<BaseLayout {title} {description} schemaJsonLd={schema}>
  <Section tight>
    <div class="bio-hero">
      <div>
        <Pill>Chi sono</Pill>
        <h1>Rafael Patron.</h1>
        <p class="lead">
          Chief AI Officer (CAIO) di Intarget DMCC e Presidente del Comitato Tecnico-Scientifico
          AIPIA. Lavoro da vent'anni tra tecnologia, trasformazione digitale e crescita; su r4f.it
          mi occupo di LLM Optimization e di come i motori AI raccontano i brand.
        </p>
        <div class="bio-hero__cta">
          <MagneticCTA href="/audit-llmo" variant="accent">Richiedi un audit</MagneticCTA>
          <Button href={RAFAEL.profile} variant="ghost" external>Profilo completo e CV</Button>
        </div>
      </div>
      <div class="bio-hero__badge">
        <RotatedBadge text="CAIO · LLMO · AIPIA CTS · 20 ANNI · 4 LIBRI · " center="r4f" size={200} rotate={-5} variant="ink" />
      </div>
    </div>
  </Section>

  <Section tone="alt">
    <div class="grid-2" style="gap: clamp(2rem, 4vw, 4rem);">
      <div class="prose">
        <Pill>Il percorso</Pill>
        <h2>Da Cogorno a Dubai, e ritorno.</h2>
        <p>
          Sono nato in Perù e cresciuto in Liguria, dai tre anni. La mia famiglia ha radici a
          Cogorno, in provincia di Genova, dove mio nonno è tornato dopo l'emigrazione in
          Sudamerica.
        </p>
        <p>
          Ho iniziato nel digital marketing quando Google era ancora giovane. SEO, SEM, growth
          hacking — li ho fatti tutti, per startup che dovevano crescere in fretta e per aziende
          che volevano innovare senza sprecare budget. Dal 2012 al 2017 ho guidato Patron
          Multimedia: nel 2017 un progetto digitale sviluppato in quel percorso è stato ceduto a
          Snap Inc.
        </p>
        <p>
          Quando l'intelligenza artificiale ha iniziato a cambiare le regole del gioco, non ho
          aspettato. Da ottobre 2019 sono in Intarget DMCC, prima come AI Program Manager e da
          giugno 2026 come Chief AI Officer. Dal 2025 presiedo il Comitato Tecnico-Scientifico di
          AIPIA. Ho scritto quattro libri: "AIO: Il tuo prossimo collega è un robot", "Growth
          Hacking", "Fatti trovare da ChatGPT" (con Filippo Fassone) e "Non è mai troppo tardi
          per l'intelligenza artificiale".
        </p>
        <p>
          Base operativa Chiavari (Liguria), con Intarget DMCC che ha sede a Dubai. Clienti in
          tutta Italia e su progetti internazionali.
        </p>
      </div>
      <div class="prose">
        <Pill>Perché LLMO</Pill>
        <h2>Il termine cambia, l'urgenza no.</h2>
        <p>
          Dopo vent'anni nel digitale ho visto il settore cambiare radicalmente con l'arrivo delle AI
          Overview e degli assistenti AI. La domanda non è più solo "come mi posiziono su Google".
          È "come compaio quando qualcuno chiede a ChatGPT chi è il migliore nel mio settore?".
        </p>
        <p>
          LLMO — Large Language Model Optimization — è la risposta concreta. Non è una buzzword:
          è un set di pratiche tecniche per rendere il brand <em>comprensibile e raccomandabile</em>{" "}
          dai modelli di linguaggio AI. Schema.org, entità Wikidata, llms.txt, citation rate,
          knowledge graph: strumenti vecchi e nuovi che funzionano insieme.
        </p>
        <p>
          L'AIO — Artificial Intelligence Optimization — resta il termine generico di famiglia.
          Lo uso ancora, e ho una pagina dedicata <a href="/audit-aio">/audit-aio</a> per chi
          arriva da quella keyword. Ma sul tema della visibilità nei motori generativi, "LLMO"
          è il termine più preciso.
        </p>
      </div>
    </div>
  </Section>

  <Section>
    <Pill>Ruoli</Pill>
    <h2>Tre cappelli, una sola direzione.</h2>
    <div class="grid-3" style="margin-top: 2.5rem;">
      {credentials.map((c) => (
        <Card title={c.title}>
          <p>{c.body}</p>
        </Card>
      ))}
    </div>
  </Section>

  <Section tone="alt">
    <div class="grid-2" style="gap: clamp(2rem, 4vw, 4rem); align-items: start;">
      <div>
        <Pill>Formazione</Pill>
        <h2>Da Genova al MIT.</h2>
        <ul class="formation-list">
          <li><strong>MIT Professional Education</strong><span>2026–2027, in corso · No Code and Agentic AI</span></li>
          <li><strong>Harvard University / CS50</strong><span>2023 · CS50's Introduction to Artificial Intelligence with Python</span></li>
          <li><strong>SDA Bocconi School of Management</strong><span>2022 · Artificial Intelligence in Action</span></li>
          <li><strong>IED Milano</strong><span>Corso di specializzazione Evolution Marketing and Social Media</span></li>
          <li><strong>Università degli Studi di Genova</strong><span>Studi universitari in Economia Aziendale</span></li>
        </ul>
      </div>
      <div>
        <Pill>Docenze</Pill>
        <h2>Cosa insegno, dove.</h2>
        <ul class="formation-list">
          {teachings.map((t) => (
            <li><strong>{t.where}</strong><span>{t.what}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section>
    <Pill>Competenze</Pill>
    <h2>Stack tecnico verificabile.</h2>
    <p class="lead">
      Le competenze chiave per il lavoro LLMO/AIO, dentro un focus più ampio su AI strategy,
      AI governance e AI Act. Percorso completo, pubblicazioni e ORCID su{" "}
      <a href={RAFAEL.profile} rel="noopener" target="_blank">rafaelpatron.com</a>.
    </p>
    <ul class="skills">
      {skills.map((s) => <li><span class="tag">{s}</span></li>)}
    </ul>
  </Section>

  <Section tone="ink">
    <div class="grid-2 split-cta">
      <div>
        <Pill>Lavoriamo insieme?</Pill>
        <h2>Parliamo del progetto.</h2>
        <p class="lead">
          Audit, consulenza o workshop: scrivimi dalla pagina contatti di rafaelpatron.it.
          Rispondo entro 24 ore lavorative; se vale la pena, ne parliamo a voce.
        </p>
      </div>
      <div class="split-cta__actions">
        <MagneticCTA href={contattiRP("chi_sono_contatta")} variant="accent">Contatta Rafael</MagneticCTA>
        <Button href="/contatti" variant="ghost">Tutti i contatti</Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .bio-hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .bio-hero h1 { margin-top: 1rem; margin-bottom: 1rem; }
  .bio-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .bio-hero__badge { display: flex; justify-content: center; }

  .formation-list {
    list-style: none;
    padding: 0;
    margin: 1.4rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .formation-list li {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-left: 1rem;
    border-left: 2px solid var(--color-accent);
  }
  .formation-list strong { font-size: 1.08rem; font-weight: 600; }
  .formation-list span { font-family: var(--font-mono); font-size: .82rem; color: var(--color-ink-muted); }

  .skills {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
  }
  .skills li { margin: 0; }

  .split-cta { gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .split-cta__actions { display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; }

  @media (max-width: 900px) {
    .bio-hero { grid-template-columns: 1fr; }
    .bio-hero__badge { justify-self: start; }
  }
</style>
