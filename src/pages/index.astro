---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import Pill from "../components/ui/Pill.astro";
import GlassHeadlineHero from "../components/ui/glass-headline-hero";
import RotatedBadge from "../components/kinetic/RotatedBadge.astro";
import MagneticCTA from "../components/kinetic/MagneticCTA.astro";
import RevealStack from "../components/kinetic/RevealStack.astro";
import {
  buildGraph,
  websiteSchema,
  personSchema,
  organizationSchema,
  llmoServiceSchema,
  breadcrumbSchema,
} from "../lib/schema";
import { contattiRP } from "../lib/site";

const title = "Consulenza LLMO Italia: farsi citare da ChatGPT e Google AI | r4f.it";
const description =
  "Consulenza LLM Optimization e AIO per imprese italiane. Audit citation rate su ChatGPT, Claude, Gemini, Perplexity e Google AI Overview. Metodo verificato, base Genova.";

const schema = buildGraph(
  websiteSchema(),
  organizationSchema(),
  personSchema(),
  llmoServiceSchema(),
  breadcrumbSchema([{ name: "Home", url: "https://r4f.it/" }])
);

const trustItems = [
  { value: "20", label: "anni tra tecnologia e crescita" },
  { value: "4", label: "libri pubblicati" },
  { value: "Presidente CTS", label: "AIPIA" },
  { value: "CAIO", label: "Intarget DMCC" },
];

const phases = [
  {
    n: "01",
    title: "Audit & diagnosi",
    body:
      "Misuro come il tuo brand appare oggi su ChatGPT, Claude, Gemini, Perplexity e nelle AI Overview di Google. Mappo i gap rispetto ai competitor e identifico le leve a impatto più rapido.",
    href: "/audit-llmo",
    cta: "Vai all'audit",
  },
  {
    n: "02",
    title: "Strategia & implementazione",
    body:
      "Schema markup, llms.txt strutturato, riscrittura per chiarezza semantica, entità Wikidata. Sprint mensili con metriche di citation rate verificabili.",
    href: "/servizi",
    cta: "Vedi i servizi",
  },
  {
    n: "03",
    title: "Formazione & autonomia",
    body:
      "Workshop pratici per team marketing, SEO, dev. Strumenti condivisi, checklist operative. Obiettivo: lasciarti competente, non dipendente.",
    href: "/formazione",
    cta: "Info formazione",
  },
];
---

<BaseLayout {title} {description} schemaJsonLd={schema}>
  <div class="r4f-glass">
    <GlassHeadlineHero
      client:load
      eyebrow="LLM Optimization · Italia"
      title="Ottimizzazione LLM / AIO"
      description="Il tuo brand dentro le risposte di ChatGPT, Gemini e degli AI Overviews di Google. Rendo il tuo sito leggibile, citabile e consigliato dai modelli linguistici."
      primaryAction={{ label: "Richiedi un audit", href: "/audit-llmo" }}
      secondaryAction={{ label: "Scopri il metodo", href: "/metodo" }}
      speed={0.25}
      colors={["#060504","#C94100","#9C5A41","#1A2A8C","#CBBFA8"]}
      height="calc(100svh - var(--r4f-header-h))"
    />
  </div>

  <Section tight class="hero">
    <div class="hero__trust" data-reveal style="--reveal-delay: 320ms">
      <RotatedBadge text="LLMO · CAIO · CTS AIPIA · 4 LIBRI · 20 ANNI · " center="r4f" size={130} rotate={-4} />
      <ul class="trust-line">
        {trustItems.map((t) => (
          <li><strong>{t.value}</strong><span>{t.label}</span></li>
        ))}
      </ul>
    </div>
  </Section>

  <Section tone="alt">
    <Pill>Il problema</Pill>
    <h2 class="section-h">La SEO che conosci non basta più.</h2>
    <div class="grid-2" style="margin-top: 2.5rem;">
      <div class="prose" data-reveal>
        <p>
          Da marzo 2025, Google genera risposte AI in SERP anche sulle query italiane. Il traffico
          organico tradizionale si riduce e chi non è ottimizzato per le risposte AI perde
          visibilità giorno dopo giorno.
        </p>
        <p>
          Il punto non è "fare SEO meglio". È fare qualcosa di diverso. I motori AI ragionano in
          modo nuovo: premiano autorevolezza verificabile, struttura dei dati, chiarezza semantica.
        </p>
      </div>
      <div class="prose" data-reveal style="--reveal-delay: 120ms">
        <p>
          Intanto, milioni di persone chiedono a ChatGPT, Gemini, Claude e Perplexity consigli su
          prodotti, professionisti e servizi. Quelle risposte stanno diventando il primo punto di
          contatto: se non ci sei, non esisti.
        </p>
        <p>
          <strong>LLMO è la risposta concreta.</strong> Non sostituisce la SEO, la estende. È il
          livello in più che serve per non restare fuori dalla conversazione.
        </p>
      </div>
    </div>
  </Section>

  <Section tone="ink" id="metodo-preview">
    <Pill>Come lavoro</Pill>
    <h2 class="section-h">Tre fasi, risultati misurabili.</h2>
    <RevealStack class="grid-3 phases" stagger={120}>
      {phases.map((p) => (
        <div class="phase-card">
          <RotatedBadge text={`FASE ${p.n} · ${p.title.toUpperCase()} · `} center={p.n} size={120} rotate={4} variant="outline" />
          <h3 class="phase-card__title">{p.title}</h3>
          <p>{p.body}</p>
          <a href={p.href} class="phase-card__cta no-underline">{p.cta} →</a>
        </div>
      ))}
    </RevealStack>
  </Section>

  <Section>
    <div class="grid-2 split">
      <div data-reveal>
        <Pill>Esperienza</Pill>
        <h2 class="section-h">20 anni nel digitale, dall'inizio dell'era AI.</h2>
        <p class="prose">
          Ho iniziato con la SEO quando ancora funzionava il keyword stuffing. Ho attraversato
          ogni aggiornamento algoritmo. Quando le regole cambiano, chi ha le basi solide si
          adatta; gli altri perdono posizioni.
        </p>
        <p class="prose">
          Oggi sono Chief AI Officer (CAIO) di Intarget DMCC, Presidente del Comitato
          Tecnico-Scientifico <a href="/aipia">AIPIA</a> e autore di <a href="/libri">quattro libri</a>{" "}
          su AI, LLMO e growth hacking.
        </p>
      </div>
      <div data-reveal style="--reveal-delay: 120ms">
        <Pill>Per chi è</Pill>
        <h2 class="section-h">Imprese che vogliono muoversi prima.</h2>
        <p class="prose">
          PMI, studi professionali, ecommerce e brand che capiscono che il mercato sta cambiando.
          Non serve un budget enorme. Serve una strategia chiara e qualcuno che sappia eseguirla.
        </p>
        <p class="prose">
          Se cerchi un partner per portare risultati concreti nell'era dell'AI search,{" "}
          <a href="/contatti">scrivimi</a>.
        </p>
      </div>
    </div>
  </Section>

  <Section tone="alt">
    <Pill>Pillar geo</Pill>
    <h2 class="section-h">Da dove parto, e dove arrivo.</h2>
    <p class="lead" style="margin-bottom: 2.5rem;">
      Base operativa Liguria, clienti in tutta Italia. Tre pagine dedicate ai mercati primari.
    </p>
    <div class="grid-3 cards-asym">
      <Card title="Genova & Liguria" href="/consulente-llmo-genova" cta="Vai al pillar">
        <p>Il mercato locale con più white space LLMO in Italia. Manifattura, nautica, turismo, vinicole.</p>
      </Card>
      <Card title="Milano & Lombardia" href="/consulente-llmo-milano" cta="Vai al pillar">
        <p>Hub corporate del paese. Per agenzie, fintech, retail e B2B che competono in SERP affollate.</p>
      </Card>
      <Card title="Resto Italia" href="/consulente-llmo-italia" cta="Vai al pillar">
        <p>Lavoro da remoto su tutto il territorio nazionale. Workshop in presenza su richiesta.</p>
      </Card>
    </div>
  </Section>

  <Section tone="ink" class="cta-final">
    <div class="cta-final__inner">
      <div>
        <Pill>Inizia da qui</Pill>
        <h2 class="section-h">Vuoi sapere come l'AI vede il tuo brand?</h2>
        <p class="lead">
          Un audit LLMO ti dice cosa risponde ChatGPT su di te oggi, dove sei invisibile, e cosa
          fare per primo. Rispondo entro 24 ore lavorative.
        </p>
      </div>
      <div class="cta-final__actions">
        <MagneticCTA href={contattiRP("home_richiedi_audit")} variant="accent">Richiedi un audit</MagneticCTA>
        <Button href="/audit-llmo" variant="ghost">Come funziona l'audit</Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .section-h { margin-bottom: .5em; }

  .hero {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    position: relative;
  }
  .hero__trust {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line-soft);
    flex-wrap: wrap;
  }

  .trust-line {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem 2.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .trust-line li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
    margin: 0;
  }
  .trust-line strong {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-transform: none;
  }

  .phases { margin-top: 2.5rem; gap: 2rem; }
  .phase-card {
    display: flex;
    flex-direction: column;
    gap: .85rem;
    align-items: flex-start;
  }
  .phase-card__title { font-family: var(--font-display); font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; }
  .phase-card__cta {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: .8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
    background: none;
    padding-top: .8rem;
  }

  .split { gap: clamp(2rem, 4vw, 4rem); align-items: start; }

  .cta-final__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .cta-final__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  @media (max-width: 900px) {
    .cta-final__inner { grid-template-columns: 1fr; }
  }
</style>
