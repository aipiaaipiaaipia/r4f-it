---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Pill from "../components/ui/Pill.astro";
import Button from "../components/ui/Button.astro";
import MagneticCTA from "../components/kinetic/MagneticCTA.astro";
import {
  buildGraph,
  organizationSchema,
  personSchema,
  llmoServiceSchema,
  breadcrumbSchema,
} from "../lib/schema";

const title = "Servizi LLMO: audit, strategia, formazione, consulenza | r4f.it";
const description =
  "Quattro modi di lavorare: call iniziale di consulenza (€249), audit LLMO completo con roadmap (€1.400, 14 giorni), strategia mensile, formazione team, consulenza continuativa. Pricing trasparente.";

const schema = buildGraph(
  organizationSchema(),
  personSchema(),
  llmoServiceSchema(),
  breadcrumbSchema([
    { name: "Home", url: "https://r4f.it/" },
    { name: "Servizi", url: "https://r4f.it/servizi" },
  ])
);

const services = [
  {
    n: "01",
    title: "Call iniziale + Audit LLMO",
    body:
      "Due ingressi. Call iniziale di consulenza (1h, prenotabile via Calendly) per testare insieme come l'AI risponde sul tuo brand. Audit LLMO completo con roadmap operativa, piano d'azione e deliverable PDF, consegna entro 14 giorni.",
    pricing: "€249 call iniziale · €1.400 audit completo con roadmap",
    href: "/audit-llmo",
    cta: "Dettagli audit",
  },
  {
    n: "02",
    title: "Strategia & implementazione",
    body:
      "Schema markup, llms.txt strutturato, riscrittura per chiarezza semantica, entità Wikidata, FAQ strategiche, ottimizzazione knowledge graph. Sprint mensili con metriche di citation rate verificabili.",
    pricing: "Sprint mensili, preventivo su richiesta",
    href: "/contatti",
    cta: "Parliamone",
  },
  {
    n: "03",
    title: "Formazione team",
    body:
      "Workshop pratici per team marketing, content, SEO e dev. Mezza giornata o giornata intera, in presenza o da remoto. Esercitazioni sul tuo sito reale. Strumenti operativi e checklist incluse.",
    pricing: "Da 4h (base) a 7h (avanzato), preventivo personalizzato",
    href: "/formazione",
    cta: "Info formazione",
  },
  {
    n: "04",
    title: "Consulenza continuativa",
    body:
      "Retainer mensile per team che vogliono un riferimento stabile sull'AI search. Review periodiche, second opinion, sblocco questioni tecniche, monitoring competitor. Sessioni regolari programmate.",
    pricing: "Retainer mensile, contatto diretto",
    href: "/contatti",
    cta: "Richiedi proposta",
  },
];

const verticals = [
  {
    id: "ecommerce",
    title: "LLMO per ecommerce",
    body:
      "Schema Product e Offer ottimizzati per Google Shopping AI e per le nuove esperienze di acquisto guidate dai LLM. Catalogo strutturato per essere compreso e raccomandato.",
  },
  {
    id: "professionisti",
    title: "LLMO per professionisti",
    body:
      "Personal branding nell'era AI. Schema Person rich, sameAs network coerente, entità citabile. Quando un utente chiede a ChatGPT chi cercare nel tuo settore, vogliamo il tuo nome nella risposta.",
  },
  {
    id: "pmi",
    title: "LLMO per PMI locali",
    body:
      "LocalBusiness schema, area servita, presidio entità geo. Il tuo studio o la tua azienda compaiono quando qualcuno cerca nella tua zona — anche se la ricerca passa per un LLM.",
  },
];
---

<BaseLayout {title} {description} schemaJsonLd={schema}>
  <Section tight>
    <Pill>Servizi</Pill>
    <h1>Quattro modi per lavorare insieme.</h1>
    <p class="lead">
      Ogni progetto parte da una diagnosi reale. Lavoro su quattro livelli — audit, strategia,
      formazione, consulenza continuativa — e ti lascio sempre più autonomo di prima.
    </p>
  </Section>

  <Section tone="alt">
    <div class="grid-2 cards-asym">
      {services.map((s) => (
        <Card number={s.n} title={s.title} href={s.href} cta={s.cta}>
          <p>{s.body}</p>
          <p class="pricing"><strong>Investimento.</strong> {s.pricing}</p>
        </Card>
      ))}
    </div>
  </Section>

  <Section>
    <Pill>Verticali</Pill>
    <h2>Tre angolazioni di applicazione.</h2>
    <p class="lead">
      Il metodo LLMO si adatta a contesti diversi. Ecco come cambia quando lavoro con ecommerce,
      professionisti o PMI locali.
    </p>
    <div class="grid-3" style="margin-top: 2.5rem;">
      {verticals.map((v) => (
        <div id={v.id} class="vertical-card">
          <h3>{v.title}</h3>
          <p>{v.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section tone="ink">
    <div class="grid-2 split-cta">
      <div>
        <Pill>Non sai da dove iniziare?</Pill>
        <h2>Parti dall'audit.</h2>
        <p class="lead">
          In un'ora di call ti dico cosa risponde l'AI sul tuo brand oggi e dove stai perdendo
          terreno. Sei libero di proseguire o di applicare quello che impari in autonomia.
        </p>
      </div>
      <div class="split-cta__actions">
        <MagneticCTA href="/audit-llmo" variant="accent">Vai all'audit LLMO</MagneticCTA>
        <Button href="/contatti" variant="ghost">Scrivimi</Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .pricing {
    margin-top: .8rem;
    padding-top: .8rem;
    border-top: 1px solid var(--color-line-soft);
    font-family: var(--font-mono);
    font-size: .82rem;
    color: var(--color-ink-soft);
  }
  .pricing strong { color: var(--color-accent-dark); }

  .vertical-card {
    padding: 1.6rem;
    border-left: 3px solid var(--color-accent);
  }
  .vertical-card h3 { margin-bottom: .6rem; }

  .split-cta { gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .split-cta__actions { display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; }
  @media (max-width: 760px) {
    .split-cta__actions { align-items: stretch; }
  }
</style>
